{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrryutaro/RLMResearchPlanner/schemas/locale-manifest.schema.json",
  "title": "RLMResearchPlanner bundled locale manifest",
  "type": "object",
  "required": ["document_type", "schema_version", "fallback_locale", "locales"],
  "properties": {
    "document_type": { "const": "RLMResearchPlanner.locale-manifest" },
    "schema_version": { "const": 1 },
    "fallback_locale": { "$ref": "#/$defs/locale" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["locale", "name", "direction", "path"],
        "properties": {
          "locale": { "$ref": "#/$defs/locale" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "direction": { "enum": ["ltr", "rtl"] },
          "path": { "type": "string", "pattern": "^[^\\\\/?#]+\\.json$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    }
  }
}
