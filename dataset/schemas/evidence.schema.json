{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrryutaro/RLMResearchData/schemas/evidence.schema.json",
  "title": "RLM research dataset evidence registry",
  "type": "object",
  "required": ["document_type", "schema_version", "evidence"],
  "properties": {
    "document_type": { "const": "RLMResearchData.evidence" },
    "schema_version": { "const": 2 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "captured_on",
          "game_version",
          "scope",
          "redistribution_allowed"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "type": { "enum": ["game_capture", "direct_observation", "document", "other"] },
          "source_ids": { "$ref": "common.schema.json#/$defs/idList" },
          "captured_on": { "$ref": "common.schema.json#/$defs/date" },
          "game_version": { "type": "string", "minLength": 1, "maxLength": 100 },
          "locale": { "$ref": "common.schema.json#/$defs/locale" },
          "scope": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "redistribution_allowed": { "type": "boolean" },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "notes": { "type": "string", "maxLength": 4000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
