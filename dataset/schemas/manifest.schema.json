{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrryutaro/RLMResearchData/schemas/manifest.schema.json",
  "title": "RLM research dataset manifest",
  "type": "object",
  "required": [
    "document_type",
    "schema_version",
    "dataset_id",
    "dataset_version",
    "game_version",
    "checked_on",
    "sources_path",
    "evidence_path",
    "aliases_path",
    "trees",
    "locales",
    "license"
  ],
  "properties": {
    "document_type": { "const": "RLMResearchData.manifest" },
    "schema_version": { "const": 2 },
    "dataset_id": { "$ref": "common.schema.json#/$defs/id" },
    "dataset_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "game_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "checked_on": { "$ref": "common.schema.json#/$defs/date" },
    "sources_path": { "$ref": "common.schema.json#/$defs/relativePath" },
    "evidence_path": { "$ref": "common.schema.json#/$defs/relativePath" },
    "aliases_path": { "$ref": "common.schema.json#/$defs/relativePath" },
    "trees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" }
        },
        "additionalProperties": false
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["locale", "path", "required"],
        "properties": {
          "locale": { "$ref": "common.schema.json#/$defs/locale" },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "required": ["name", "url", "attribution"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "format": "uri" },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
